rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function signedIn() { return request.auth != null; }
  function verified() { return signedIn() && request.auth.token.email_verified == true; }
  function owner(uid) { return signedIn() && request.auth.uid == uid; }
  function admin() { return verified() && request.auth.token.admin == true; }
  function valid(d, uid) {
   return d.keys().hasAll(['uid','email','phoneNumber','serviceInterests','accountStatus','waitlistStatus','createdAt','updatedAt'])
    && d.keys().hasOnly(['uid','email','phoneNumber','serviceInterests','accountStatus','waitlistStatus','createdAt','updatedAt'])
    && d.uid == uid && d.email == request.auth.token.email
    && d.phoneNumber is string && d.phoneNumber.matches('^[+][1-9][0-9]{7,14}$')
    && d.serviceInterests is list && d.serviceInterests.size() > 0 && d.serviceInterests.size() <= 9
    && d.serviceInterests.toSet().size() == d.serviceInterests.size()
    && d.serviceInterests.hasOnly(['AI-Assisted CAD Design','FEA / Structural Simulation','CFD / Aerodynamics Simulation','Aerospace Engineering Solutions','Mechanical Engineering Solutions','Manufacturing Engineering','CAM / CNC Programming','AI-Powered Engineering Research','Other Engineering Services'])
    && d.updatedAt == request.time;
  }
  match /users/{uid} {
   allow get: if (owner(uid) && verified()) || admin();
   allow list: if admin();
   allow create: if owner(uid) && valid(request.resource.data, uid)
    && request.resource.data.accountStatus == 'active'
    && request.resource.data.waitlistStatus == 'registered'
    && request.resource.data.createdAt == request.time;
   allow update: if owner(uid) && verified() && valid(request.resource.data, uid)
    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['phoneNumber','serviceInterests','updatedAt']);
   allow delete: if owner(uid) && request.auth.token.auth_time > request.time.toMillis() / 1000 - 300;
  }
 }
}